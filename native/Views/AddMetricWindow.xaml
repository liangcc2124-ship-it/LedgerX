<Window x:Class="LedgerX.Views.AddMetricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增指标" Width="470" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/ledgerx-custom-v2.ico">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="新增指标" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="创建一个可以持续增加或减少的个人指标。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,26"/>
            <TextBlock Text="指标名称" Margin="0,0,0,7"/>
            <TextBox x:Name="NameBox" Style="{StaticResource TextFieldStyle}" MaxLength="20"/>
            <TextBlock Text="说明" Margin="0,18,0,7"/>
            <TextBox x:Name="SubtitleBox" Style="{StaticResource TextFieldStyle}" MaxLength="40"/>
            <TextBlock Text="显示单位" Margin="0,18,0,7"/>
            <ComboBox x:Name="FormatBox" Style="{StaticResource ComboFieldStyle}"/>
            <Border Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                <TextBlock Text="创建后会出现在财务总览。点击指标卡即可记录增加或减少，每条记录都需要日期。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="CancelClick" Margin="0,0,10,0"/>
            <Button Content="创建指标" Style="{StaticResource PrimaryButtonStyle}" Click="CreateClick"/>
        </StackPanel>
    </Grid>
</Window>
