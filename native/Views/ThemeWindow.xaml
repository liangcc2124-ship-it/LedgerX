<Window x:Class="LedgerX.Views.ThemeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观与皮肤" Width="460" Height="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="pack://application:,,,/Assets/ledgerx-custom-v2.ico">
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="外观与皮肤" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选择内置皮肤，或导入仅含 --lx-* 变量的 CSS。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,24"/>
            <ListBox x:Name="ThemeList" Height="150" SelectionChanged="ThemeChanged"/>
            <TextBlock Text="CSS 不执行脚本、网络资源或选择器，只读取安全的颜色、字体和圆角变量。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="导入 CSS" Style="{StaticResource SecondaryButtonStyle}" Click="ImportClick" Margin="0,0,8,0"/>
            <Button Content="导出当前 CSS" Style="{StaticResource SecondaryButtonStyle}" Click="ExportClick" Margin="0,0,8,0"/>
            <Button Content="完成" Style="{StaticResource PrimaryButtonStyle}" Click="DoneClick"/>
        </StackPanel>
    </Grid>
</Window>
