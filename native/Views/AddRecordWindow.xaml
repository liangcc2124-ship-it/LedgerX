<Window x:Class="LedgerX.Views.AddRecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增记录" Width="480" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/ledgerx-custom-v2.ico">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="新增记录" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="一次记录会自动更新相关指标。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,7,0,25"/>
            <TextBlock Text="记录类型" Margin="0,0,0,7"/><ComboBox x:Name="TypeBox" Style="{StaticResource ComboFieldStyle}" SelectionChanged="TypeChanged"/>
            <TextBlock Text="金额" Margin="0,17,0,7"/><TextBox x:Name="AmountBox" Style="{StaticResource TextFieldStyle}"/>
            <TextBlock Text="日期" Margin="0,17,0,7"/><DatePicker x:Name="DateBox" SelectedDate="{x:Static sys:DateTime.Today}" Padding="8,5" xmlns:sys="clr-namespace:System;assembly=System.Runtime"/>
            <TextBlock Text="分类" Margin="0,17,0,7"/><TextBox x:Name="CategoryBox" Style="{StaticResource TextFieldStyle}"/>
            <TextBlock Text="账户" Margin="0,17,0,7"/><TextBox x:Name="AccountBox" Text="现金储备" Style="{StaticResource TextFieldStyle}"/>
            <TextBlock Text="备注（可选）" Margin="0,17,0,7"/><TextBox x:Name="NoteBox" Style="{StaticResource TextFieldStyle}"/>
            <Border Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                <TextBlock x:Name="ImpactText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="CancelClick"/>
            <Button Content="保存记录" Style="{StaticResource PrimaryButtonStyle}" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>
