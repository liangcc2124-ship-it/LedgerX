<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LedgerX</AssemblyName>
    <RootNamespace>LedgerX</RootNamespace>
    <ApplicationIcon>..\assets\ledgerx-custom-v2.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>LedgerX - local-first personal finance metrics for Windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\ledgerx-custom-v2.ico" Link="Assets\ledgerx-custom-v2.ico" />
    <Resource Include="..\assets\ledgerx-custom-v2.png" Link="Assets\ledgerx-custom-v2.png" />
    <EmbeddedResource Include="Themes\*.css" />
  </ItemGroup>
</Project>
