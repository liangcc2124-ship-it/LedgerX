<Window x:Class="LedgerX.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LedgerX.Models" Title="LedgerX" Width="1360" Height="860" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/ledgerx-custom-v2.ico">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/><Setter Property="Padding" Value="20"/></Style>
        <Style TargetType="DataGrid"><Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="VerticalGridLinesBrush" Value="Transparent"/><Setter Property="RowHeight" Value="35"/><Setter Property="ColumnHeaderHeight" Value="36"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    </Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,28"><Image Source="pack://application:,,,/Assets/ledgerx-custom-v2.png" Width="40" Height="40" Stretch="Uniform"/><TextBlock Text="LedgerX" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="overview" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="财务总览"/></StackPanel></Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="metrics" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="指标中心"/></StackPanel></Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="records" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="全部记录"/></StackPanel></Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="analysis" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="财务分析"/></StackPanel></Button>
                    <Button Style="{StaticResource SidebarButtonStyle}" Tag="data" Click="NavigateClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="数据管理"/></StackPanel></Button>
                </StackPanel>
                <Button Grid.Row="2" Style="{StaticResource SidebarButtonStyle}" Click="ThemeClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0"/><TextBlock Text="外观与皮肤"/></StackPanel></Button>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <Grid x:Name="OverviewPage" Margin="36,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="300"/></Grid.RowDefinitions>
                <Grid><StackPanel><TextBlock Text="财务总览" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="今天也要清醒地掌握自己的钱。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="外观" Style="{StaticResource SecondaryButtonStyle}" Click="ThemeClick" Margin="0,0,9,0"/><Button Content="{Binding PrivacyButtonText}" Style="{StaticResource SecondaryButtonStyle}" Click="PrivacyClick" Margin="0,0,9,0"/><Button Content="＋ 新增记录" Style="{StaticResource PrimaryButtonStyle}" Click="AddClick"/></StackPanel></Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,26,0,22"><ItemsControl ItemsSource="{Binding VisibleMetrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:MetricItem}">
                    <Border Style="{StaticResource CardStyle}" Width="214" Height="118" Margin="0,0,14,12" MouseLeftButtonUp="MetricCardClick" Cursor="Hand"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" Click="MetricPrivacyClick" ToolTip="隐藏或显示"><TextBlock Text="&#xE890;" FontFamily="Segoe Fluent Icons"/></Button></Grid><TextBlock Grid.Row="1" Text="{Binding DisplayValue}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Text="{Binding Subtitle}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><TextBlock Text="最近记录" FontSize="17" FontWeight="SemiBold"/><Button Content="查看全部" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right" Tag="records" Click="NavigateClick"/></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="Horizontal" Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="{DynamicResource AppBackgroundBrush}"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="130"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="150"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="账户" Binding="{Binding Account}" Width="160"/><DataGridTextColumn Header="金额" Binding="{Binding DisplayAmount}" Width="150"/></DataGrid.Columns></DataGrid></Grid></Border>
            </Grid>
            <Grid x:Name="MetricsPage" Visibility="Collapsed" Margin="40">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,24">
                    <StackPanel><TextBlock Text="指标中心" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="创建自己的指标，或只保留真正关心的内置指标。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/></StackPanel>
                    <Button Content="＋ 新增指标" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddMetricClick"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><DockPanel>
                            <CheckBox IsChecked="{Binding IsEnabled}" Tag="{Binding}" Checked="MetricEnabledChanged" Unchecked="MetricEnabledChanged" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Button Content="删除" Tag="{Binding}" Click="DeleteMetricClick" DockPanel.Dock="Right" Margin="14,0,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCustom}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedTextBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding ManagementHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                        </DockPanel></Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid x:Name="RecordsPage" Visibility="Collapsed" Margin="40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,24"><TextBlock Text="全部记录" FontSize="28" FontWeight="SemiBold"/><Button Content="＋ 新增记录" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right" Click="AddClick"/></Grid><DataGrid x:Name="AllRecordsGrid" Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="日期" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="130"/><DataGridTextColumn Header="类型" Binding="{Binding TypeLabel}" Width="160"/><DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="账户" Binding="{Binding Account}" Width="160"/><DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/><DataGridTextColumn Header="金额" Binding="{Binding DisplayAmount}" Width="150"/></DataGrid.Columns><DataGrid.ContextMenu><ContextMenu><MenuItem Header="删除选中记录" Click="DeleteRecordClick"/></ContextMenu></DataGrid.ContextMenu></DataGrid></Grid>
            <Grid x:Name="AnalysisPage" Visibility="Collapsed" Margin="40"><StackPanel><TextBlock Text="财务分析" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="LedgerX 会根据你的手动记录实时计算现金、成本、资产、负债与资金链。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,26"/><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="当前判断" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AnalysisText" TextWrapping="Wrap" FontSize="15" LineHeight="27" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></Grid>
            <Grid x:Name="DataPage" Visibility="Collapsed" Margin="40"><StackPanel><TextBlock Text="数据管理" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="所有数据只保存在这台电脑。你可以随时备份和恢复。" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,26"/><WrapPanel><Button Content="导出备份" Style="{StaticResource PrimaryButtonStyle}" Click="BackupClick" Margin="0,0,10,0"/><Button Content="从备份恢复" Style="{StaticResource SecondaryButtonStyle}" Click="RestoreClick"/></WrapPanel><TextBlock x:Name="DataPathText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,22,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
