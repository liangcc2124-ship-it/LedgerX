<Window x:Class="LedgerX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="LedgerX" Width="1360" Height="860" MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/ledgerx-custom-v2.ico"
        Background="#F7F6F3">
    <Grid>
        <Border x:Name="LoadingPanel" Background="#F7F6F3" Panel.ZIndex="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="LedgerX" FontFamily="Segoe UI Variable" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="正在整理数字…" FontFamily="Microsoft YaHei UI" Foreground="#76736F" Margin="0,9,0,0" />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#F7F6F3" />
    </Grid>
</Window>
